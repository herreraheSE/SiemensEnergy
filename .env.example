# === OpenRouter API ===
# Obtener en: https://openrouter.ai
# Asegúrate de que la cuenta tiene créditos habilitados
OPENROUTER_API_KEY=sk-or-v1-

# === FastAPI Server ===
# Generar una clave segura con: python generate_secret_key.py
# Mínimo 32 bytes recomendado para SHA256
SECRET_KEY=your-secret-key-change-this-in-production-min-32-bytes
